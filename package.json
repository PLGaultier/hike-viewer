{
  "name": "hike-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local webapp that turns a GPX track + timestamped photos into an animated 3D flyover video",
  "scripts": {
    "start": "node server.js",
    "mp4": "bash render/to-mp4.sh",
    "video": "node render/record.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "maplibre-gl": "^4.7.1",
    "puppeteer": "^25.8.0",
    "sharp": "^0.35.3"
  }
}