{
  "name": "hike-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local webapp that turns a GPX track + timestamped photos into an animated 3D flyover video",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server.js",
    "doctor": "node scripts/doctor.mjs",
    "video": "node render/record.mjs",
    "mp4": "node render/to-mp4.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "maplibre-gl": "^4.7.1",
    "puppeteer": "^25.8.0",
    "sharp": "^0.35.3"
  }
}
